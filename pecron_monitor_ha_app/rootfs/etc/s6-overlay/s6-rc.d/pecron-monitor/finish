#!/bin/sh
# Halt the container when the runner exits non-zero (invalid configuration),
# passing on its exit code. 256 means it was killed by a signal during shutdown.
if [ "$1" -ne 0 ] && [ "$1" -ne 256 ]; then
  echo "$1" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi
